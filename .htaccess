# ============================================================
#  ДомЭксперт — .htaccess
#  Apache 2.4+
# ============================================================

Options -Indexes

# --- Кодировка ---
AddDefaultCharset UTF-8

# --- Страница ошибок ---
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
ErrorDocument 500 /404.php

# --- Заголовки безопасности ---
# Встраиваемые калькуляторы (/embed/) должны открываться в чужих iframe, поэтому
# для этого пути НЕ ставим X-Frame-Options, а разрешаем фрейминг через CSP.
# Остальной сайт остаётся SAMEORIGIN. Через SetEnvIf, т.к. <If> в .htaccess недоступен.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/embed" PRODOM_EMBED=1
</IfModule>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN" env=!PRODOM_EMBED
    Header set Content-Security-Policy "frame-ancestors *" env=PRODOM_EMBED
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS: браузер сам ходит по https, не дожидаясь редиректа, — минус один
    # хоп для пользователя и защита от подмены на первом переходе.
    # Срок намеренно 6 месяцев без includeSubDomains и preload: так правило
    # обратимо. Когда убедитесь, что все поддомены живут по https, можно
    # поднять до max-age=31536000 и добавить includeSubDomains.
    # Заголовок по спецификации игнорируется браузером, если пришёл по http,
    # поэтому отдавать его безусловно безопасно.
    Header always set Strict-Transport-Security "max-age=15768000"
</IfModule>

# --- Сжатие (gzip) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
</IfModule>

# --- Кэширование статики ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/gif                 "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType application/x-font-woff2 "access plus 1 year"
</IfModule>

# --- 301-КАТОВЕР: prodom-expert.ru → prodom-expert.com (переезд 31.10.2026) ---
# Весь трафик .ru (www и без) 301-редиректом на .com тем же путём. Стоит ПЕРВЫМ
# среди rewrite, чтобы ловить все запросы (включая картинки) до прочих правил.
# Причина переезда: РФ требует подтверждения домена на Госуслугах, владелец — КГ-ИП.
# .ru держим живым с этим 301 как можно дольше (мост для передачи веса на .com).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(www\.)?prodom-expert\.ru$ [NC]
    RewriteRule ^ https://prodom-expert.com%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Прозрачная отдача WebP ---
# Если браузер поддерживает WebP и рядом с .jpg/.png лежит .webp — отдаём его
# (в 3-4 раза легче). Шаблоны не меняем: запрос идёт на .jpg, сервер подменяет
# на .webp с правильным Content-Type. Соцсети-скрейперы без Accept:image/webp
# получают исходный .jpg — og:image не ломается.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ /$1.webp [T=image/webp,E=WEBP:1,L]
</IfModule>
<IfModule mod_headers.c>
    # Прокси/CDN должны кэшировать jpg и webp раздельно (зависит от Accept)
    Header append Vary Accept env=WEBP
</IfModule>
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# --- Запрет прямого доступа к includes ---
<FilesMatch "^.*\.(php)$">
    <If "%{REQUEST_URI} =~ m|^/includes/|">
        Require all denied
    </If>
</FilesMatch>

# --- Приёмник фотографий не публикуется ---
# photos-inbox/ — рабочая папка с оригиналами снимков (полный размер, метаданные).
# Наружу отдаются только обработанные копии из assets/img/photos/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^photos-inbox/ - [F,L]
</IfModule>

# --- Служебный кэш не публикуется ---
# cache/ — производные данные (словарные векторы для подбора похожих статей).
# Перестраивается сам после правки реестра; наружу отдавать нечего.
<IfModule mod_rewrite.c>
    RewriteRule ^cache/ - [F,L]
</IfModule>

# --- Запрет прямого доступа к текстам статей и разметке калькуляторов ---
# /articles/<cat>/<slug>.html и /calc-forms/<slug>.html — HTML-фрагменты без
# <head>, canonical и title. Сайт читает их с диска через article.php и calc.php,
# по HTTP они не нужны и создают дубли.
<IfModule mod_authz_core.c>
    <FilesMatch "\.html$">
        <If "%{REQUEST_URI} =~ m#^/(articles|calc-forms)/#">
            Require all denied
        </If>
    </FilesMatch>
</IfModule>

# --- Защита системных файлов ---
# robots.txt, ads.txt и llms.txt должны отдаваться всем — они для обходчиков.
# Всё остальное, что начинается с точки (.htaccess, .htpasswd, .gitignore, .env),
# наружу не отдаётся. Раньше здесь стоял Require all granted на .htaccess и
# .htpasswd — конфигурация сервера была доступна по прямой ссылке.
<FilesMatch "^(robots\.txt|ads\.txt|llms\.txt|favicon\.ico)$">
    Require all granted
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- Рабочие файлы разработки не публикуются ---
# На боевой сервер они попадают при заливке каталога целиком. Ни один из них
# сайту для работы не нужен: .md — заметки, .sh/.py — скрипты обслуживания,
# .env — ключи внешних сервисов, .json в scripts/ — рабочие выгрузки.
<FilesMatch "\.(md|sh|py|env|log|bak|sql|yml|yaml|ini|lock|cfg|toml)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^scripts/    - [F,L]
    RewriteRule ^\.venv      - [F,L]
    RewriteRule ^\.idea/     - [F,L]
    RewriteRule ^screens/    - [F,L]
</IfModule>

# --- Один канонический адрес: https://prodom-expert.ru (без www) ---
# Важно: если SSL обрывается на Nginx/Cloudflare, Apache видит HTTPS=off — без
# проверки X-Forwarded-Proto получится ERR_TOO_MANY_REDIRECTS.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # www → без www, сразу на HTTPS
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    # HTTP → HTTPS только если запрос действительно не HTTPS (в т.ч. за прокси)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ============================================================
    #  ЧПУ (человекопонятные адреса)
    #  Старые адреса ?slug=/?cat= отдают 301 на новые, чтобы сохранить
    #  индекс и ссылочный вес. Проверка по %{THE_REQUEST} (исходная строка
    #  запроса) исключает петлю: внутренние переписывания её не меняют.
    #  Знак ? в конце цели отбрасывает старый query string, иначе редирект
    #  ведёт на /article/foo/?slug=foo — лишний адрес для обхода.
    #
    #  Цель указывается АБСОЛЮТНЫМ адресом с https://. При относительной цели
    #  (/article/foo/) Apache достраивает схему сам, а за nginx он видит
    #  HTTPS=off и отдаёт http:// — получалась цепочка 301 → 301 → 200
    #  на каждом старом адресе.
    # ============================================================

    # 301: устаревшие слаги-дубли → актуальная статья
    # regulirovka-plastikovyh-okon (13.07, короткий текст) заменён более полным
    # материалом regulirovka-plastikovykh-okon (19.07) — тема одна, слаги почти
    # совпадают, поэтому старый адрес склеиваем с новым, а не держим двумя URL.
    RewriteRule ^article/regulirovka-plastikovyh-okon/?$ https://prodom-expert.ru/article/regulirovka-plastikovykh-okon/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+article\.php\?slug=regulirovka-plastikovyh-okon[\s&] [NC]
    RewriteRule ^ https://prodom-expert.ru/article/regulirovka-plastikovykh-okon/? [R=301,L]

    # 301: /article.php?slug=foo  →  /article/foo/
    RewriteCond %{THE_REQUEST} \s/+article\.php\?slug=([A-Za-z0-9-]+)[\s&] [NC]
    RewriteRule ^ https://prodom-expert.ru/article/%1/? [R=301,L]

    # 301: /category.php?cat=foo&page=2  →  /category/foo/page/2/
    RewriteCond %{THE_REQUEST} \s/+category\.php\?cat=([A-Za-z0-9-]+)&page=([0-9]+)[\s&] [NC]
    RewriteRule ^ https://prodom-expert.ru/category/%1/page/%2/? [R=301,L]

    # 301: /category.php?cat=foo  →  /category/foo/
    RewriteCond %{THE_REQUEST} \s/+category\.php\?cat=([A-Za-z0-9-]+)[\s&] [NC]
    RewriteRule ^ https://prodom-expert.ru/category/%1/? [R=301,L]

    # 301: /calc.php?slug=foo  →  /calc/foo/
    RewriteCond %{THE_REQUEST} \s/+calc\.php\?slug=([A-Za-z0-9-]+)[\s&] [NC]
    RewriteRule ^ https://prodom-expert.ru/calc/%1/? [R=301,L]

    # 301: /calculators.php  →  /calculators/
    RewriteCond %{THE_REQUEST} \s/+calculators\.php[\s?] [NC]
    RewriteRule ^ https://prodom-expert.ru/calculators/? [R=301,L]

    # 301: /vidzhety.php  →  /vidzhety/
    RewriteCond %{THE_REQUEST} \s/+vidzhety\.php[\s?] [NC]
    RewriteRule ^ https://prodom-expert.ru/vidzhety/? [R=301,L]

    # 301: /termin.php?slug=foo  →  /slovar/foo/
    RewriteCond %{THE_REQUEST} \s/+termin\.php\?slug=([A-Za-z0-9-]+)[\s&] [NC]
    RewriteRule ^ https://prodom-expert.ru/slovar/%1/? [R=301,L]

    # 301: /slovar.php  →  /slovar/
    RewriteCond %{THE_REQUEST} \s/+slovar\.php[\s?] [NC]
    RewriteRule ^ https://prodom-expert.ru/slovar/? [R=301,L]

    # Внутренние переписывания ЧПУ → реальные скрипты (без редиректа)
    RewriteRule ^calculators/?$ calculators.php [L,QSA]
    RewriteRule ^vidzhety/?$ vidzhety.php [L,QSA]
    RewriteRule ^calc/([A-Za-z0-9-]+)/?$ calc.php?slug=$1 [L,QSA]
    RewriteRule ^embed/calc/([A-Za-z0-9-]+)/?$ embed.php?slug=$1 [L,QSA]
    RewriteRule ^slovar/?$ slovar.php [L,QSA]
    RewriteRule ^slovar/([A-Za-z0-9-]+)/?$ termin.php?slug=$1 [L,QSA]
    # Партнёрский редиректор (фильтр ботов, см. go.php). QSA сохраняет ?p=<slug>.
    RewriteRule ^go/([A-Za-z0-9_-]+)/?$ go.php?to=$1 [L,QSA]
    # 301: склейка дублей (слабая страница → сильная), перед общим правилом статей
    RewriteRule ^article/vybor-remontnoj-brigady/?$ https://prodom-expert.ru/article/kak-vybrat-brigadu-dlya-remonta/ [R=301,L]
    RewriteRule ^article/bojler-nakopitelnyj-ili-protochnyj/?$ https://prodom-expert.ru/article/vodonagrevatel-boyler-vybor-montazh/ [R=301,L]

    # 301: опечаточные/битые слаги из GSC (были 404) → канонические ЧПУ.
    # Варочная панель + духовка: podklyuchie→podklyuchenie, без -i-, dukhovki→duhovki.
    RewriteRule ^article/podklyuchie-varochnoy-paneli-i-duhovki/?$ https://prodom-expert.ru/article/podklyuchenie-varochnoy-paneli-i-duhovki/ [R=301,L]
    RewriteRule ^article/podklyuchenie-varochnoy-paneli-duhovki/?$ https://prodom-expert.ru/article/podklyuchenie-varochnoy-paneli-i-duhovki/ [R=301,L]
    RewriteRule ^article/podklyuchenie-varochnoy-paneli-i-dukhovki/?$ https://prodom-expert.ru/article/podklyuchenie-varochnoy-paneli-i-duhovki/ [R=301,L]
    # Коллекторная разводка: слаг с недотранслитом (raz + кириллица «водка» = %D0%B2%D0%BE%D0%B4%D0%BA%D0%B0).
    # Матчим по THE_REQUEST — он хранит исходное процент-кодирование (общее правило ниже его не ловит: не ASCII).
    RewriteCond %{THE_REQUEST} \s/+article/kollektornaya-raz%D0%B2%D0%BE%D0%B4%D0%BA%D0%B0-vody/?[\s?] [NC]
    RewriteRule ^ https://prodom-expert.ru/article/kollektornaya-razvodka-vody/? [R=301,L]

    RewriteRule ^article/([A-Za-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]
    RewriteRule ^category/([A-Za-z0-9-]+)/page/([0-9]+)/?$ category.php?cat=$1&page=$2 [L,QSA]
    RewriteRule ^category/([A-Za-z0-9-]+)/?$ category.php?cat=$1 [L,QSA]
</IfModule>
