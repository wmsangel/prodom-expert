<?xml version="1.0" encoding="UTF-8"?>
<!--
  Недельная проверка готовности к AdSense (adsense-weekly.sh).
  Раз в неделю (понедельник 10:30) дёргает GSC-базу и, если трафик дорос до
  порога, шлёт уведомление macOS (и Telegram владельцу, если задан chat_id).

  Установка (один раз):
    cp scripts/com.prodom.adsense-weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.prodom.adsense-weekly.plist

  Проверка/тест:
    launchctl list | grep adsense
    launchctl start com.prodom.adsense-weekly    # прогнать немедленно
    tail -f scripts/adsense-readiness.log        # что насчитал
    launchctl unload ~/Library/LaunchAgents/com.prodom.adsense-weekly.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prodom.adsense-weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/igorzagorodnyi/Sites/ad.domexpert/scripts/adsense-weekly.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/igorzagorodnyi/Sites/ad.domexpert</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Понедельник, 10:30 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/igorzagorodnyi/Sites/ad.domexpert/scripts/adsense-weekly.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/igorzagorodnyi/Sites/ad.domexpert/scripts/adsense-weekly.launchd.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
